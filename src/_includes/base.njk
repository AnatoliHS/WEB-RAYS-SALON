{% import "macros.njk" as m %}<!DOCTYPE html>
<html lang="en-CA">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {%- set pageTitle = (title + " · " + site.name) if title else (site.name + " · Hair Salon in Cobourg, Ontario") -%}
  {%- set pageDesc = description or site.description -%}
  {%- set ogImage = site.url + "/assets/img/og.jpg" -%}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}" />
  <meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large' }}" />
  <meta name="theme-color" content="#151515" />
  <meta name="geo.region" content="CA-ON" />
  <meta name="geo.placename" content="{{ site.city }}" />
  {% if site.url %}<link rel="canonical" href="{{ site.url }}{{ page.url }}" />{% endif %}

  <!-- Social sharing (absolute URLs need site.url in _data/site.json) -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_CA" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ pageDesc }}" />
  {% if site.url %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ ogImage }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Woman with long glossy brunette hair, smiling, at {{ site.name }}" />
  {% endif %}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  <meta name="twitter:description" content="{{ pageDesc }}" />
  {% if site.url %}<meta name="twitter:image" content="{{ ogImage }}" />{% endif %}

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />

  <link rel="preload" as="image" href="/assets/img/hero-portrait.jpg" imagesrcset="/assets/img/hero-portrait-1000.jpg 1000w, /assets/img/hero-portrait.jpg 2000w" imagesizes="(max-width: 900px) 100vw, 50vw" fetchpriority="high" />
  <link rel="stylesheet" href="/assets/css/site.css" />
  <script>document.documentElement.classList.add("js")</script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HairSalon",
    "name": "{{ site.name }}",
    "description": "{{ site.description }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.street }}",
      "addressLocality": "{{ site.city }}",
      "addressRegion": "{{ site.region }}",
      "postalCode": "{{ site.postal }}",
      "addressCountry": "{{ site.country }}"
    },
    "areaServed": ["Cobourg", "Port Hope", "Northumberland County"],
    "hasMap": "{{ site.mapsLink }}",
    {% if site.phone %}"telephone": "{{ site.phone }}",{% endif %}
    {% if site.url %}"url": "{{ site.url }}",
    "image": "{{ ogImage }}",{% endif %}
    "sameAs": ["{{ site.facebook }}"]
  }
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" id="nav">
    {#- "Shopfront" (desktop): links on the left, the wordmark centred like the
        sign over the door, address + Book on the right. Under 900px it falls
        back to brand left + menu button right, opening the ivory drawer. -#}
    <div class="nav__inner">
      <nav class="nav__links" aria-label="Primary">
        <a href="/#services">Services</a>
        <a href="/#studio">The Studio</a>
        <a href="/#gallery">Gallery</a>
        <a href="/#visit">Visit</a>
      </nav>
      <div class="nav__mid">
        <svg class="nav__star" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 0C10.6 6.4 13.6 9.4 20 10 13.6 10.6 10.6 13.6 10 20 9.4 13.6 6.4 10.6 0 10 6.4 9.4 9.4 6.4 10 0Z"/></svg>
        <a class="brand" href="/" aria-label="{{ site.name }}, home">
          <span class="brand__mark">Rays</span>
          <span class="brand__sub">Beauty Salon</span>
        </a>
        <svg class="nav__star" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 0C10.6 6.4 13.6 9.4 20 10 13.6 10.6 10.6 13.6 10 20 9.4 13.6 6.4 10.6 0 10 6.4 9.4 9.4 6.4 10 0Z"/></svg>
      </div>
      <div class="nav__end">
        <span class="nav__addr">{{ site.street }}</span>
        <a class="btn btn--small nav__cta" href="/#book">Book</a>
        <button class="nav__toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
          <span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <div class="menu" id="menu" hidden>
    <nav aria-label="Mobile">
      <a href="/#services" style="--i:0">Services</a>
      <a href="/#studio" style="--i:1">The Studio</a>
      <a href="/#gallery" style="--i:2">Gallery</a>
      <a href="/#visit" style="--i:3">Visit</a>
    </nav>
    <span class="menu__dot" aria-hidden="true"></span>
    <div class="menu__foot">
      <a class="btn" href="/#book">Book an appointment</a>
      <p class="menu__addr">{{ site.street }} · {{ site.city }}</p>
    </div>
  </div>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p class="footer__line">Hair &amp; <em>beauty</em> in the heart of Cobourg.</p>

      <p class="footer__mark" aria-label="{{ site.name }}">
        <span class="footer__rays" aria-hidden="true">Rays</span>
        <span class="footer__sub" aria-hidden="true">Beauty Salon</span>
      </p>

      <a class="btn" href="/#book">Book an appointment</a>

      <ul class="footer__row">
        <li><span class="footer__h">Visit</span>{{ site.street }}, {{ site.city }}<a class="link" href="{{ site.mapsLink }}" target="_blank" rel="noopener">Directions</a></li>
        <li><span class="footer__h">Hours</span>{% if site.hours.length %}{% for h in site.hours %}<span>{{ h.days }} {{ h.time }}</span>{% endfor %}{% else %}By appointment{% endif %}</li>
        <li><span class="footer__h">Call</span>{{ m.call(site, "link") }}</li>
        <li><span class="footer__h">Follow</span><a href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a></li>
      </ul>
    </div>

    <div class="wrap footer__base">
      <nav class="footer__nav" aria-label="Footer">
        <a href="/#services">Services</a><a href="/#studio">The Studio</a><a href="/#gallery">Gallery</a><a href="/#visit">Visit</a>
      </nav>
      <p>&copy; <span id="year">2026</span> {{ site.name }}</p>
    </div>
  </footer>

  <script src="/assets/js/site.js" defer></script>
</body>
</html>
